APP_NAME=Curso Intensivo de Ingles Tecnico CUGDL x Growmo
APP_ENV=dev
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth / One Tap
GOOGLE_CLIENT_ID=

# Solo para desarrollo local y pruebas sin token real de Google.
ALLOW_DEV_EMAIL_LOGIN=true
ALLOWED_EMAIL_DOMAINS=estudiantes.udg.mx,alumnos.udg.mx

# Supabase (opcional pero recomendado para persistencia real)
SUPABASE_URL=
SUPABASE_KEY=

# Supabase dedicado para el pre-registro de ingles tecnico.
# Si lo dejas vacio, el pre-registro usa SUPABASE_URL / SUPABASE_KEY.
SUPABASE_PREREG_URL=
SUPABASE_PREREG_KEY=
SUPABASE_PREREG_TABLE=english_tech_preregistrations

# Admin Authentication (para payment verification dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu_contraseña_segura_aqui
ADMIN_TOKEN=tu_token_aleatorio_fuerte_aqui
